{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "reaction-time",
    "title": "반응속도 테스트",
    "genre": "reaction",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "서버가 정한 신호 시점에 얼마나 빠르게 반응하는지 측정합니다.",
    "description": "한국어·영어 UI를 지원하며 충분한 준비 간격 뒤 화면이 초록색으로 바뀌는 순간 누릅니다. 게임 안에서 소리와 재시작을 제어할 수 있으며 OWOGG verifier가 challenge seed로 신호 시점을 재생성하고 evidence에서 평균 반응 시간을 계산합니다.",
    "tags": ["reaction", "timing", "verified"]
  },
  "input": ["mouse", "touch", "keyboard"],
  "presentation": { "orientation": "any", "aspectRatio": "16:9" },
  "playConfig": {
    "version": 1,
    "rulesetRevision": 2,
    "verifierId": "reaction-time-v1",
    "variants": [{ "id": "standard", "title": "기본", "default": true }],
    "allowedConfigs": [{ "difficultyId": "normal", "variantId": "standard", "rewardFactor": 1 }]
  },
  "progression": {
    "type": "round",
    "range": { "min": 0, "max": 7, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success"] },
    "score": {
      "unit": "ms",
      "direction": "asc",
      "precision": 0,
      "range": { "min": 50, "max": 10000, "outOfRange": "reject" }
    },
    "metrics": {
      "rounds": {
        "type": "integer",
        "range": { "min": 0, "max": 7, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": {
    "round_completed": { "maxPerAttempt": 7 },
    "completed": { "maxPerAttempt": 1 }
  }
}
