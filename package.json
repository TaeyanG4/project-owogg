{
  "name": "owogg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "generate:favicon": "tsx scripts/generate-favicon.ts",
    "architecture:check": "tsx scripts/verify-architecture.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "test:scripts": "node --import tsx --test scripts/**/*.test.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "smoke:prod": "tsx scripts/verify-production.ts",
    "auth:prod:check": "tsx scripts/check-auth-readiness.ts",
    "discord:commands:register": "tsx scripts/register-discord-commands.ts",
    "discord:commands:register:guild": "tsx scripts/register-discord-commands-guild.ts",
    "discord:commands:check": "tsx scripts/discord-commands-check.ts",
    "admin:password:hash": "tsx scripts/admin-password-hash.ts",
    "i18n:sync-check": "tsx scripts/check-i18n-sync.ts",
    "staging:preflight": "tsx scripts/staging-preflight.ts",
    "staging:cloudflare:preflight": "tsx scripts/staging-cloudflare-domains.ts",
    "staging:d1:verify": "tsx scripts/staging-d1-target.ts",
    "branches:audit": "tsx scripts/branch-audit.ts",
    "multiplayer:cost:model": "tsx scripts/relay-cost-model.ts",
    "e2e": "tsx e2e/run.ts",
    "verify": "pnpm install --frozen-lockfile && pnpm format:check && pnpm docs:check && pnpm architecture:check && pnpm lint && pnpm typecheck && pnpm typecheck:scripts && pnpm test && pnpm test:scripts && pnpm build",
    "deploy": "pnpm --filter @owogg/api deploy && pnpm --filter @owogg/web deploy",
    "d1:migrate": "pnpm exec wrangler d1 migrations apply DB --local --config apps/api/wrangler.jsonc",
    "d1:migrate:prod": "pnpm exec wrangler d1 migrations apply DB --remote --config apps/api/wrangler.jsonc",
    "d1:migrate:staging": "pnpm exec wrangler d1 migrations apply owogg-d1-staging --remote --env staging --config apps/api/wrangler.staging.generated.jsonc --x-provision=false --x-auto-create=false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@owogg/core": "workspace:*",
    "@owogg/db": "workspace:*",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.12",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
