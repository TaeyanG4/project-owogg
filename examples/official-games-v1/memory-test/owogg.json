{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "memory-test",
    "title": "Sequence Memory Test",
    "genre": "skill-test",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "Memorize and repeat the color sequence generated from a server seed.",
    "localizations": {
      "ko": {
        "title": "순서 기억력 테스트",
        "shortDescription": "서버 seed로 정해진 색상 순서를 기억하고 그대로 입력하세요."
      },
      "ja": {
        "title": "順番記憶テスト",
        "shortDescription": "サーバーseedで決まる色の順番を覚えて、その通りに入力します。"
      },
      "zh": {
        "title": "顺序记忆测试",
        "shortDescription": "记住由服务器seed生成的颜色顺序，并按原顺序输入。"
      }
    },
    "description": [
      "description.md",
      "description_kr.md",
      "description_ja.md",
      "description_zh.md"
    ],
    "tags": ["memory", "pattern", "brain", "verified"]
  },
  "input": ["mouse", "touch", "keyboard"],
  "presentation": { "orientation": "landscape", "aspectRatio": "16:9", "defaultMode": "default" },
  "playConfig": {
    "version": 1,
    "rulesetRevision": 1,
    "verifierId": "memory-test-v1",
    "variants": [{ "id": "standard", "title": "기본", "default": true }],
    "allowedConfigs": [{ "difficultyId": "normal", "variantId": "standard", "rewardFactor": 1 }]
  },
  "progression": {
    "type": "level",
    "range": { "min": 0, "max": 50, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success", "failure"] },
    "score": {
      "unit": "Level",
      "direction": "desc",
      "precision": 0,
      "range": { "min": 0, "max": 50, "outOfRange": "reject" }
    },
    "metrics": {
      "inputs": {
        "type": "integer",
        "range": { "min": 0, "max": 1275, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": {
    "level_completed": { "maxPerAttempt": 50 },
    "completed": { "maxPerAttempt": 1 }
  }
}
