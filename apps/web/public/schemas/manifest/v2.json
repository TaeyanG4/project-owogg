{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owogg.com/schemas/manifest/v2.json",
  "title": "OWOGG Game Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "progression", "result"],
  "properties": {
    "$schema": { "type": "string", "const": "https://owogg.com/schemas/manifest/v2.json" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "genre", "mode", "playModes"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 3, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "genre": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["single", "multi"] },
        "playModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["single", "local-multi", "online-multi"] }
        },
        "shortDescription": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "single" } }, "required": ["mode"] },
          "then": { "properties": { "playModes": { "const": ["single"] } } }
        },
        {
          "if": { "properties": { "mode": { "const": "multi" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "playModes": {
                "contains": { "enum": ["local-multi", "online-multi"] },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "input": {
      "type": "array",
      "items": { "type": "string", "enum": ["keyboard", "mouse", "touch", "gamepad"] },
      "uniqueItems": true
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": { "type": "string", "enum": ["any", "landscape", "portrait"] },
        "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
      }
    },
    "difficulties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "default": { "type": "boolean" }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "endless", "stage", "level", "round", "wave", "chapter", "lap", "custom"]
        },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score"],
      "properties": {
        "outcome": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["values"],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["neutral", "success", "failure", "win", "loss", "draw"]
                  }
                }
              }
            }
          ]
        },
        "score": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/score" }] },
        "metrics": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "leaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "events": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "maxPerAttempt": { "type": "integer", "minimum": 1 } }
      }
    },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
    "multiplayer": { "$ref": "#/$defs/managedMultiplayerRequest" }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "outOfRange": { "type": "string", "enum": ["clamp", "reject"], "default": "clamp" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "direction", "range"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["asc", "desc"] },
        "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["integer", "number"] },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "operator", "value"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["score", "outcome", "progression", "metric", "event"]
        },
        "key": { "type": "string", "minLength": 1 },
        "aggregate": { "type": "string", "enum": ["max", "min", "sum", "count"] },
        "operator": { "type": "string", "enum": ["==", "!=", ">", ">=", "<", "<="] },
        "value": { "type": ["number", "string", "boolean"] }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "condition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "scope": { "type": "string", "enum": ["session", "lifetime"] },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "multiplayerPlayers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 2, "maximum": 64 },
        "max": { "type": "integer", "minimum": 2, "maximum": 64 }
      }
    },
    "multiplayerRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation",
        "lifecycle",
        "persistence",
        "latency",
        "reconnect",
        "hiddenInformation",
        "simultaneousResponse",
        "joinInProgress",
        "spectators"
      ],
      "properties": {
        "simulation": { "type": "string", "enum": ["turn", "event", "continuous", "rollback"] },
        "lifecycle": { "type": "string", "enum": ["match", "continuous", "persistent"] },
        "persistence": { "type": "string", "enum": ["none", "match", "player", "world"] },
        "latency": { "type": "string", "enum": ["relaxed", "interactive", "critical"] },
        "reconnect": { "type": "string", "enum": ["none", "rejoin", "resume"] },
        "hiddenInformation": { "type": "boolean" },
        "simultaneousResponse": { "type": "boolean" },
        "joinInProgress": { "type": "boolean" },
        "spectators": { "type": "boolean" }
      }
    },
    "multiplayerClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion"],
      "properties": { "protocolVersion": { "type": "integer", "const": 1 } }
    },
    "turnGridConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boardWidth", "boardHeight", "winLength"],
      "properties": {
        "boardWidth": { "type": "integer", "minimum": 3, "maximum": 25 },
        "boardHeight": { "type": "integer", "minimum": 3, "maximum": 25 },
        "winLength": { "type": "integer", "minimum": 3, "maximum": 25 }
      }
    },
    "reactionArenaConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds", "responseWindowMs"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 1, "maximum": 20 },
        "responseWindowMs": { "type": "integer", "minimum": 100, "maximum": 10000 }
      }
    },
    "realtimePaddleConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldWidth", "fieldHeight", "targetScore"],
      "properties": {
        "fieldWidth": { "type": "integer", "minimum": 320, "maximum": 4096 },
        "fieldHeight": { "type": "integer", "minimum": 180, "maximum": 2160 },
        "targetScore": { "type": "integer", "minimum": 1, "maximum": 21 }
      }
    },
    "managedMultiplayerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestVersion",
        "kind",
        "template",
        "players",
        "requirements",
        "config",
        "client"
      ],
      "properties": {
        "requestVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "managed-template" },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "enum": ["turn-grid", "reaction-arena", "realtime-paddle"] },
            "version": { "type": "integer", "const": 1 }
          }
        },
        "players": { "$ref": "#/$defs/multiplayerPlayers" },
        "requirements": { "$ref": "#/$defs/multiplayerRequirements" },
        "config": {
          "oneOf": [
            { "$ref": "#/$defs/turnGridConfig" },
            { "$ref": "#/$defs/reactionArenaConfig" },
            { "$ref": "#/$defs/realtimePaddleConfig" }
          ]
        },
        "client": { "$ref": "#/$defs/multiplayerClient" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "template": { "properties": { "id": { "const": "turn-grid" } }, "required": ["id"] }
            },
            "required": ["template"]
          },
          "then": {
            "properties": {
              "players": { "const": { "min": 2, "max": 2 } },
              "requirements": {
                "properties": {
                  "simulation": { "const": "turn" },
                  "lifecycle": { "const": "match" },
                  "persistence": { "const": "match" },
                  "latency": { "const": "relaxed" },
                  "reconnect": { "const": "resume" },
                  "hiddenInformation": { "const": false },
                  "simultaneousResponse": { "const": false },
                  "joinInProgress": { "const": false },
                  "spectators": { "const": false }
                }
              },
              "config": { "$ref": "#/$defs/turnGridConfig" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "properties": { "id": { "const": "reaction-arena" } },
                "required": ["id"]
              }
            },
            "required": ["template"]
          },
          "then": {
            "properties": {
              "players": {
                "properties": {
                  "min": { "maximum": 8 },
                  "max": { "maximum": 8 }
                }
              },
              "requirements": {
                "properties": {
                  "simulation": { "const": "event" },
                  "lifecycle": { "const": "match" },
                  "persistence": { "const": "match" },
                  "latency": { "const": "interactive" },
                  "reconnect": { "const": "none" },
                  "hiddenInformation": { "const": false },
                  "simultaneousResponse": { "const": true },
                  "joinInProgress": { "const": false },
                  "spectators": { "const": false }
                }
              },
              "config": { "$ref": "#/$defs/reactionArenaConfig" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "properties": { "id": { "const": "realtime-paddle" } },
                "required": ["id"]
              }
            },
            "required": ["template"]
          },
          "then": {
            "properties": {
              "players": { "const": { "min": 2, "max": 2 } },
              "requirements": {
                "properties": {
                  "simulation": { "const": "continuous" },
                  "lifecycle": { "const": "continuous" },
                  "persistence": { "const": "match" },
                  "latency": { "const": "interactive" },
                  "reconnect": { "const": "resume" },
                  "hiddenInformation": { "const": false },
                  "simultaneousResponse": { "const": true },
                  "joinInProgress": { "const": false },
                  "spectators": { "const": false }
                }
              },
              "config": { "$ref": "#/$defs/realtimePaddleConfig" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "leaderboard": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
        },
        "required": ["leaderboard"]
      },
      "then": {
        "properties": { "result": { "properties": { "score": { "not": { "type": "null" } } } } }
      }
    },
    {
      "if": { "required": ["multiplayer"] },
      "then": {
        "properties": {
          "game": {
            "properties": {
              "mode": { "const": "multi" },
              "playModes": { "contains": { "const": "online-multi" }, "minContains": 1 }
            }
          },
          "leaderboard": { "properties": { "enabled": { "const": false } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "game": {
            "properties": {
              "playModes": { "contains": { "const": "online-multi" }, "minContains": 1 }
            },
            "required": ["playModes"]
          }
        },
        "required": ["game"]
      },
      "then": { "required": ["multiplayer"] }
    }
  ]
}
