{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "reaction-time",
    "title": "Reaction Time Test",
    "genre": "skill-test",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "Measure how quickly you react to an unpredictable visual signal.",
    "localizations": {
      "ko": {
        "title": "반응속도 테스트",
        "shortDescription": "예측하기 어려운 신호 시점에 얼마나 빠르게 반응하는지 측정합니다."
      },
      "ja": {
        "title": "反応速度テスト",
        "shortDescription": "予測できない視覚信号にどれだけ速く反応できるか測定します。"
      },
      "zh": {
        "title": "反应速度测试",
        "shortDescription": "测量你对不可预测的视觉信号作出反应的速度。"
      }
    },
    "description": [
      "description.md",
      "description_kr.md",
      "description_ja.md",
      "description_zh.md"
    ],
    "tags": ["reaction", "timing", "verified"]
  },
  "input": ["mouse", "touch", "keyboard"],
  "presentation": { "orientation": "any", "aspectRatio": "16:9", "defaultMode": "theater" },
  "playConfig": {
    "version": 1,
    "rulesetRevision": 3,
    "verifierId": "reaction-time-v1",
    "variants": [{ "id": "standard", "title": "기본", "default": true }],
    "allowedConfigs": [{ "difficultyId": "normal", "variantId": "standard", "rewardFactor": 1 }]
  },
  "progression": {
    "type": "round",
    "range": { "min": 0, "max": 7, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success"] },
    "score": {
      "unit": "ms",
      "direction": "asc",
      "precision": 0,
      "range": { "min": 50, "max": 10000, "outOfRange": "reject" }
    },
    "metrics": {
      "rounds": {
        "type": "integer",
        "range": { "min": 0, "max": 7, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": {
    "round_completed": { "maxPerAttempt": 7 },
    "completed": { "maxPerAttempt": 1 }
  }
}
