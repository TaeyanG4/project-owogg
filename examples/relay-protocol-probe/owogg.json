{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "relay-protocol-probe",
    "title": "Relay Protocol Probe",
    "genre": "party",
    "mode": "multi",
    "playModes": ["online-multi"],
    "shortDescription": "2~8인이 공용 Relay SDK의 broadcast, direct, snapshot, reconnect를 확인하는 예제",
    "description": "서버에 게임별 driver나 ruleset을 추가하지 않고 제작자 코드가 application protocol과 host-authoritative 상태를 구현하는 OWOGG Relay 참조 게임입니다.",
    "tags": ["relay", "multiplayer", "reference"]
  },
  "input": ["mouse", "touch", "keyboard"],
  "presentation": {
    "orientation": "any",
    "aspectRatio": "16:9"
  },
  "progression": { "type": "none" },
  "result": { "score": null },
  "leaderboard": { "enabled": false },
  "multiplayer": {
    "version": 1,
    "transport": { "kind": "websocket", "protocolVersion": 1 },
    "runtime": { "kind": "relay" },
    "players": { "min": 2, "max": 8 },
    "features": {
      "reconnect": "resume",
      "directMessages": true,
      "hostSnapshot": true,
      "joinInProgress": false,
      "spectators": false
    }
  }
}
