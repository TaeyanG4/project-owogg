{
  "name": "@owogg/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev src/worker.ts",
    "deploy": "wrangler deploy --minify src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --experimental-sqlite --import tsx --test test/**/*.test.ts && pnpm test:workers",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@owogg/contracts": "workspace:*",
    "@owogg/core": "workspace:*",
    "@owogg/db": "workspace:*",
    "@owogg/game-sdk": "workspace:*",
    "@owogg/shared": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "fflate": "^0.8.2",
    "hono": "^4.7.2",
    "satori": "^0.29.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "4.1.0",
    "wrangler": "^4.121.0"
  }
}
