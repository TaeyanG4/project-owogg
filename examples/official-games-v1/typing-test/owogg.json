{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "typing-test",
    "title": "타자 속도 테스트",
    "genre": "typing",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "90초 동안 한 줄씩 입력하고 서버가 검증한 종합 점수를 기록하세요.",
    "description": "한국어·영어 UI를 독립적으로 전환하고, 게임 안에서 한국어·영어·일본어·중국어 긴 지문 중 하나를 선택합니다. 서버 challenge seed가 지문 순서를 정하고 verifier가 90초 입력 증거와 서버 경과 시간을 대조해 WPM, CPM, 정확도 및 이들을 함께 반영한 종합 점수를 계산합니다.",
    "tags": ["typing", "brain", "verified"]
  },
  "input": ["keyboard"],
  "presentation": { "orientation": "landscape", "aspectRatio": "16:9" },
  "playConfig": {
    "version": 1,
    "rulesetRevision": 3,
    "verifierId": "typing-test-v1",
    "variants": [
      { "id": "ko", "title": "한국어", "default": true },
      { "id": "en", "title": "English" },
      { "id": "ja", "title": "日本語" },
      { "id": "zh", "title": "中文" }
    ],
    "allowedConfigs": [
      { "difficultyId": "normal", "variantId": "ko", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "en", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "ja", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "zh", "rewardFactor": 1 }
    ]
  },
  "progression": {
    "type": "stage",
    "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success"] },
    "score": {
      "unit": "점",
      "direction": "desc",
      "precision": 0,
      "range": { "min": 0, "max": 1500, "outOfRange": "reject" }
    },
    "metrics": {
      "wpm": {
        "type": "integer",
        "range": { "min": 0, "max": 300, "outOfRange": "reject" }
      },
      "cpm": {
        "type": "integer",
        "range": { "min": 0, "max": 1500, "outOfRange": "reject" }
      },
      "accuracy": {
        "type": "integer",
        "range": { "min": 0, "max": 100, "outOfRange": "reject" }
      },
      "typedChars": {
        "type": "integer",
        "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
      },
      "correctChars": {
        "type": "integer",
        "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": { "completed": { "maxPerAttempt": 1 } }
}
