{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "aim-test",
    "title": "Aim Test",
    "genre": "skill-test",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "Click server-seeded targets as quickly and accurately as possible.",
    "localizations": {
      "ko": {
        "title": "에임 테스트",
        "shortDescription": "서버 seed로 생성된 표적을 빠르고 정확하게 클릭하세요."
      },
      "ja": {
        "title": "エイムテスト",
        "shortDescription": "サーバーseedで生成された標的を素早く正確にクリックします。"
      },
      "zh": {
        "title": "瞄准测试",
        "shortDescription": "尽可能快速且准确地点击由服务器seed生成的目标。"
      }
    },
    "description": [
      "description.md",
      "description_kr.md",
      "description_ja.md",
      "description_zh.md"
    ],
    "tags": ["aim", "reaction", "verified"]
  },
  "input": ["mouse", "touch"],
  "presentation": { "orientation": "landscape", "aspectRatio": "16:9", "defaultMode": "theater" },
  "difficulties": [
    { "id": "normal", "title": "보통", "default": true },
    { "id": "hard", "title": "어려움" }
  ],
  "playConfig": {
    "version": 1,
    "rulesetRevision": 2,
    "verifierId": "aim-test-v1",
    "variants": [{ "id": "standard", "title": "표준", "default": true }],
    "allowedConfigs": [
      { "difficultyId": "normal", "variantId": "standard", "rewardFactor": 1 },
      { "difficultyId": "hard", "variantId": "standard", "rewardFactor": 1.25 }
    ]
  },
  "progression": {
    "type": "stage",
    "range": { "min": 0, "max": 30, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success"] },
    "score": {
      "unit": "ms",
      "direction": "asc",
      "precision": 0,
      "range": { "min": 500, "max": 120000, "outOfRange": "reject" }
    },
    "metrics": {
      "hits": {
        "type": "integer",
        "range": { "min": 0, "max": 30, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": {
    "target_hit": { "maxPerAttempt": 30 },
    "completed": { "maxPerAttempt": 1 }
  }
}
