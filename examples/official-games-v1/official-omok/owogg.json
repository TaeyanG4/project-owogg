{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "official-omok",
    "title": "오목",
    "genre": "board",
    "mode": "multi",
    "playModes": ["local-multi", "online-multi"],
    "shortDescription": "한 기기 대전과 온라인 Relay 대전을 한 게임에서 선택하는 15×15 오목",
    "description": [
      "description.md",
      "description_kr.md",
      "description_ja.md",
      "description_zh.md"
    ],
    "tags": ["omok", "board", "local", "online"]
  },
  "input": ["mouse", "touch"],
  "presentation": { "orientation": "landscape", "aspectRatio": "16:9", "defaultMode": "theater" },
  "progression": { "type": "none" },
  "result": { "outcome": null, "score": null },
  "leaderboard": { "enabled": false },
  "multiplayer": {
    "version": 1,
    "transport": { "kind": "websocket", "protocolVersion": 1 },
    "runtime": { "kind": "relay" },
    "players": { "min": 2, "max": 2 },
    "features": {
      "reconnect": "resume",
      "directMessages": true,
      "hostSnapshot": true,
      "joinInProgress": false,
      "spectators": false
    }
  }
}
