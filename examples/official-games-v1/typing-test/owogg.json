{
  "$schema": "https://owogg.com/schemas/manifest/v1.json",
  "schemaVersion": 1,
  "game": {
    "slug": "typing-test",
    "title": "Typing Speed Test",
    "genre": "skill-test",
    "mode": "single",
    "playModes": ["single"],
    "shortDescription": "Type line by line for 90 seconds and record a server-verified combined score.",
    "localizations": {
      "ko": {
        "title": "타자 속도 테스트",
        "shortDescription": "90초 동안 한 줄씩 입력하고 서버가 검증한 종합 점수를 기록하세요."
      },
      "ja": {
        "title": "タイピング速度テスト",
        "shortDescription": "90秒間1行ずつ入力し、サーバー検証済みの総合スコアを記録します。"
      },
      "zh": {
        "title": "打字速度测试",
        "shortDescription": "在90秒内逐行输入，并记录经服务器验证的综合得分。"
      }
    },
    "description": [
      "description.md",
      "description_kr.md",
      "description_ja.md",
      "description_zh.md"
    ],
    "tags": ["typing", "brain", "verified"]
  },
  "input": ["keyboard"],
  "presentation": { "orientation": "landscape", "aspectRatio": "16:9", "defaultMode": "default" },
  "playConfig": {
    "version": 1,
    "rulesetRevision": 3,
    "verifierId": "typing-test-v1",
    "variants": [
      { "id": "ko", "title": "한국어", "default": true },
      { "id": "en", "title": "English" },
      { "id": "ja", "title": "日本語" },
      { "id": "zh", "title": "中文" }
    ],
    "allowedConfigs": [
      { "difficultyId": "normal", "variantId": "ko", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "en", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "ja", "rewardFactor": 1 },
      { "difficultyId": "normal", "variantId": "zh", "rewardFactor": 1 }
    ]
  },
  "progression": {
    "type": "stage",
    "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
  },
  "result": {
    "outcome": { "values": ["success"] },
    "score": {
      "unit": "점",
      "direction": "desc",
      "precision": 0,
      "range": { "min": 0, "max": 1500, "outOfRange": "reject" }
    },
    "metrics": {
      "wpm": {
        "type": "integer",
        "range": { "min": 0, "max": 300, "outOfRange": "reject" }
      },
      "cpm": {
        "type": "integer",
        "range": { "min": 0, "max": 1500, "outOfRange": "reject" }
      },
      "accuracy": {
        "type": "integer",
        "range": { "min": 0, "max": 100, "outOfRange": "reject" }
      },
      "typedChars": {
        "type": "integer",
        "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
      },
      "correctChars": {
        "type": "integer",
        "range": { "min": 0, "max": 5000, "outOfRange": "reject" }
      }
    }
  },
  "leaderboard": { "enabled": true },
  "events": { "completed": { "maxPerAttempt": 1 } }
}
